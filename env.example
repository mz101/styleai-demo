# Replicate API Token für Gen-4 AI-Modell
# Erhalten Sie Ihren Token von: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Amazon Product Advertising API Credentials
# Erhalten Sie diese von: https://webservices.amazon.com/paapi5/documentation/
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_PARTNER_TAG=your_amazon_partner_tag_here

# Token für die Feed-API (ohne Token ist die Feed-API gesperrt)
FEED_API_TOKEN=your_feed_api_token_here

# Flask Konfiguration
FLASK_ENV=production
FLASK_DEBUG=False

# Sicherheit (z. B. erzeugen mit: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here_change_in_production

# HTTP-Zugangsschutz (kein Standard-Passwort – ohne AUTH_PASSWORD ist der Login deaktiviert)
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me_to_a_strong_password

# Database
# SQLite wird automatisch genutzt. Keine Konfiguration nötig.

# DigitalOcean Spaces Konfiguration
# Bucket ist öffentlich. Frontend/DB sollen die CDN-URL verwenden.
SPACES_KEY=your_digitalocean_spaces_key
SPACES_SECRET=your_digitalocean_spaces_secret
SPACES_REGION=fra1
SPACES_ENDPOINT=https://style-ai.fra1.digitaloceanspaces.com
SPACES_BUCKET=style-ai
SPACES_CDN_DOMAIN=https://style-ai.fra1.cdn.digitaloceanspaces.com
SPACES_PUBLIC=1
SPACES_MAX_UPLOAD_MB=8

# SSO (Service-übergreifendes Login)
# Geheimer gemeinsamer Schlüssel mit Service A (HMAC für SSO-Token)
SSO_SHARED_SECRET=change_me_sso_shared_secret
# Secret für Signatur des eigenen Auth-Cookies
SESSION_SECRET=change_me_session_secret
# Setze auf 1/true in Produktion (HTTPS), damit Cookies Secure sind
COOKIE_SECURE=1
# Optional: Fallback-URL bei SSO-Fehlschlag, sonst /login
# SSO_FALLBACK_URL=https://service-a.example/login